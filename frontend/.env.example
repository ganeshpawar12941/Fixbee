# Use the reachable HTTPS backend origin in EAS builds. For local Android emulator use
# http://10.0.2.2:5000; for local iOS simulator/web use http://localhost:5000.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google OAuth client IDs must come from the Google Cloud OAuth consent project.
# The native app sends an ID token issued for the Web client to the existing backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Required for native iOS sign-in and the iOS URL scheme in app.config.js.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
# Configure this Android OAuth client with package com.ganeshpawar.fixbee and the EAS signing SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
# Optional for Expo Go / AuthSession testing; standalone native builds use native Google Sign-In.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your_expo_client_id.apps.googleusercontent.com

# Optional. Defaults to frontend/google-services.json for Android FCM setup.
# For EAS builds, set this to the path of an EAS file environment variable.
# GOOGLE_SERVICES_FILE=./google-services.json
